{
  "name": "mealawerider-app-rn",
  "version": "0.1.0",
  "private": true,
  "description": "Mealawe Rider: the delivery-rider app (React Native + Expo)",
  "main": "expo-router/entry",
  "packageManager": "npm@10.9.2",
  "engines": {
    "node": "^20.19.4 || ^22.13.0 || ^24.3.0 || >=25.0.0"
  },
  "scripts": {
    "// dev server": "────────────────────────────────",
    "start": "expo start --dev-client",
    "start:local": "cross-env EXPO_PUBLIC_ENV=local expo start --dev-client",
    "start:staging": "cross-env EXPO_PUBLIC_ENV=staging expo start --dev-client",
    "start:prod": "cross-env EXPO_PUBLIC_ENV=production expo start --dev-client",
    "start:clear": "expo start -c",
    "// android (local run, scoped to one ABI)": "────────────────────────────────",
    "android": "cross-env ORG_GRADLE_PROJECT_reactNativeArchitectures=arm64-v8a expo run:android",
    "android:local": "cross-env EXPO_PUBLIC_ENV=local ORG_GRADLE_PROJECT_reactNativeArchitectures=arm64-v8a expo run:android",
    "android:staging": "cross-env EXPO_PUBLIC_ENV=staging ORG_GRADLE_PROJECT_reactNativeArchitectures=arm64-v8a expo run:android",
    "android:prod": "cross-env EXPO_PUBLIC_ENV=production ORG_GRADLE_PROJECT_reactNativeArchitectures=arm64-v8a expo run:android",
    "// ios (local run)": "────────────────────────────────",
    "ios": "expo run:ios",
    "ios:staging": "cross-env EXPO_PUBLIC_ENV=staging expo run:ios",
    "ios:prod": "cross-env EXPO_PUBLIC_ENV=production expo run:ios",
    "// prebuild": "────────────────────────────────",
    "prebuild": "expo prebuild --clean",
    "// eas build - android": "────────────────────────────────",
    "build:dev:android": "npx eas-cli@25.3.0 build --profile development --platform android",
    "build:staging:android": "npx eas-cli@25.3.0 build --profile staging --platform android",
    "build:staging-preview:android": "npx eas-cli@25.3.0 build --profile staging-preview --platform android",
    "build:prod:android": "npx eas-cli@25.3.0 build --profile production --platform android",
    "build:prod-preview:android": "npx eas-cli@25.3.0 build --profile production-preview --platform android",
    "// eas build - ios": "────────────────────────────────",
    "build:dev:ios": "npx eas-cli@25.3.0 build --profile development --platform ios",
    "build:staging:ios": "npx eas-cli@25.3.0 build --profile staging --platform ios",
    "build:staging-preview:ios": "npx eas-cli@25.3.0 build --profile staging-preview --platform ios",
    "build:prod:ios": "npx eas-cli@25.3.0 build --profile production --platform ios",
    "build:prod-preview:ios": "npx eas-cli@25.3.0 build --profile production-preview --platform ios",
    "// eas build - both platforms": "────────────────────────────────",
    "build:staging:all": "npx eas-cli@25.3.0 build --profile staging --platform all",
    "build:staging-preview:all": "npx eas-cli@25.3.0 build --profile staging-preview --platform all",
    "build:prod:all": "npx eas-cli@25.3.0 build --profile production --platform all",
    "build:prod-preview:all": "npx eas-cli@25.3.0 build --profile production-preview --platform all",
    "// eas submit - android": "────────────────────────────────",
    "submit:android:internal": "npx eas-cli@25.3.0 submit --profile internal --platform android --latest",
    "submit:android:alpha": "npx eas-cli@25.3.0 submit --profile alpha --platform android --latest",
    "submit:android:beta": "npx eas-cli@25.3.0 submit --profile beta --platform android --latest",
    "submit:android:production": "npx eas-cli@25.3.0 submit --profile production --platform android --latest",
    "// eas submit - ios (TestFlight internal group; external groups are manual in App Store Connect)": "────────────────────────────────",
    "submit:ios:internal": "npx eas-cli@25.3.0 submit --profile internal --platform ios --latest",
    "submit:ios:production": "npx eas-cli@25.3.0 submit --profile production --platform ios --latest",
    "// eas workflows (manual only, see .eas/workflows/)": "────────────────────────────────",
    "workflow:staging": "npx eas-cli@25.3.0 workflow:run .eas/workflows/staging.yml",
    "workflow:production-preview": "npx eas-cli@25.3.0 workflow:run .eas/workflows/production-preview.yml",
    "workflow:deploy": "npx eas-cli@25.3.0 workflow:run .eas/workflows/deploy.yml",
    "// eas update (OTA)": "────────────────────────────────",
    "update:staging": "npx eas-cli@25.3.0 update --branch staging --environment preview",
    "update:production": "npx eas-cli@25.3.0 update --branch production --environment production",
    "// lint & typecheck": "────────────────────────────────",
    "lint": "eslint . --max-warnings 0",
    "lint:fix": "eslint . --fix",
    "typecheck": "tsc --noEmit",
    "test": "node --import ./scripts/pure-test/register.mjs --experimental-strip-types --no-warnings --test \"src/**/__tests__/*.test.mts\"",
    "check": "npm run typecheck && npm run lint && npm test",
    "// e2e (maestro)": "────────────────────────────────",
    "e2e": "maestro test .maestro/flows",
    "// misc": "────────────────────────────────",
    "icons": "node scripts/generate-tab-icons.mjs",
    "doctor": "expo-doctor"
  },
  "dependencies": {
    "@notifee/react-native": "9.1.8",
    "@react-native-firebase/app": "26.1.0",
    "@react-native-firebase/messaging": "26.1.0",
    "@shopify/flash-list": "2.0.2",
    "expo": "~57.0.31",
    "expo-application": "~57.0.3",
    "expo-build-properties": "~57.0.14",
    "expo-camera": "~57.0.6",
    "expo-constants": "~57.0.6",
    "expo-dev-client": "~57.0.14",
    "expo-file-system": "~57.0.7",
    "expo-font": "~57.0.4",
    "expo-haptics": "~57.0.3",
    "expo-image-picker": "~57.0.20",
    "expo-intent-launcher": "~57.0.1",
    "expo-linking": "~57.0.7",
    "expo-location": "~57.0.22",
    "expo-router": "~57.0.29",
    "expo-secure-store": "~57.0.1",
    "expo-splash-screen": "~57.0.7",
    "expo-status-bar": "~57.0.1",
    "expo-system-ui": "~57.0.2",
    "expo-task-manager": "~57.0.21",
    "expo-updates": "~57.0.26",
    "lottie-react-native": "~7.3.8",
    "lucide-react-native": "1.61.0",
    "nativewind": "5.0.0-rc.0",
    "react": "19.2.3",
    "react-dom": "19.2.3",
    "react-native": "0.86.3",
    "react-native-css": "3.0.7",
    "react-native-gesture-handler": "~2.32.0",
    "react-native-maps": "1.27.2",
    "react-native-mmkv": "4.3.2",
    "react-native-nitro-modules": "0.36.5",
    "react-native-reanimated": "4.5.1",
    "react-native-safe-area-context": "~5.7.0",
    "react-native-screens": "~4.26.0",
    "react-native-svg": "15.15.4",
    "react-native-view-shot": "5.1.0",
    "react-native-web": "~0.21.0",
    "react-native-worklets": "0.10.1",
    "zod": "4.6.7",
    "zustand": "5.0.15"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "4.3.3",
    "@types/react": "~19.2.2",
    "cross-env": "10.1.0",
    "eslint": "9.39.5",
    "eslint-config-expo": "~57.0.1",
    "expo-doctor": "1.21.5",
    "postcss": "8.5.31",
    "sharp": "0.35.5",
    "tailwindcss": "4.3.3",
    "typescript": "~6.0.3"
  },
  "overrides": {
    "lightningcss": "1.30.1"
  },
  "resolutions": {
    "lightningcss": "1.30.1"
  },
  "expo": {
    "doctor": {
      "reactNativeDirectoryCheck": {
        "exclude": [
          "@notifee/react-native"
        ]
      }
    }
  }
}
